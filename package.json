{
	"name": "command-center",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run openapi:components && vite build",
		"preview": "vite preview",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"openapi:components": "bun run scripts/generate-openapi-components.ts",
		"catalog:example": "bun run scripts/generate-catalog-example.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:up": "docker compose up -d postgres"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.40.0",
		"@scalar/sveltekit": "^0.3.17",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24",
		"@valibot/to-json-schema": "^1.7.1",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"js-yaml": "^5.4.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.0",
		"svelte": "^5.56.1",
		"svelte-adapter-bun": "1.0.1",
		"svelte-check": "^4.6.0",
		"sveltekit-openapi-generator": "^0.1.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"valibot": "^1.4.2"
	}
}
