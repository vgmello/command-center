# Copy to .env for local development. .env is gitignored; this file is not.

# Which implementation of the workspace port the app runs against.
# Known values: fixture. Anything else fails at startup rather than falling back —
# a typo here would otherwise serve invented numbers as if they were real.
# The signed-in user and their pins are app-owned, so this port has no data source
# behind it. Telemetry, CI/CD, the service catalog and the estate are configured
# through SOURCES_CONFIG below instead.
WORKSPACE_SOURCE=fixture

# Allow a connections file to name the fixture providers alongside real ones.
# Unset means it cannot: a production file naming "fixture-cloud" is refused rather
# than serving seeded numbers with nothing on the page admitting it. Set it to the
# exact string "true" for local development, where one real provider is configured
# and the other kinds are still seeded.
SOURCES_ALLOW_FIXTURES=

# Octopus Deploy, when a connection names the `octopus` provider. The connections
# file references this by name; the value never appears in a log or an error.
OCTOPUS_API_KEY=

# Coralogix, when a connection names the `coralogix` provider. Its baseUrl is the
# region root (Coralogix is region-partitioned and has no global endpoint).
CORALOGIX_API_KEY=

# Postgres for the source store — what the data sources told us, kept so we do not
# ask again. Unset means no persistence: reads fall back to the in-memory tier alone,
# which is correct but hits the upstream APIs far more often.
# `bun run db:up` starts one locally; `bun run db:migrate` applies the schema.
DATABASE_URL=

# How often a single connection may be asked, and how much unused budget can
# accumulate. Caching lowers how often we ask; it does not cap it, and eight
# instances starting cold after a deploy miss on everything at once — so this is
# what makes exceeding a documented rate limit impossible rather than unlikely.
# The burst is what lets a page of panels load at once rather than over seconds.
SOURCE_RATE_PER_SECOND=5
SOURCE_RATE_BURST=10

# Which catalog the app reads its domains and services from.
# Known values: fixture, file. Anything else fails at startup rather than falling
# back — a typo that quietly served the fixtures would put invented services on a
# production dashboard with nothing admitting it.
# The catalog holds what is DECLARED: what a service is, who owns it, where its
# runbook lives. Status, error rates and instance counts are readings and come from
# the connected sources.
# Replacing this with a database is one class and one resolver entry.
CATALOG_SOURCE=fixture

# The catalog file, when CATALOG_SOURCE=file. YAML or JSON; see catalog.example.yaml,
# which is generated from the fixtures by `bun run catalog:example`.
CATALOG_FILE=

# Path to the data-source connections file. Unset means the fixture providers are
# connected, and the app behaves exactly as it does with no configuration at all.
# See docs/superpowers/specs/2026-09-04-data-source-plugins-design.md for the format.
SOURCES_CONFIG=

# Bearer tokens for the public JSON API under /api/v1, comma-separated.
# Unset means the API is CLOSED, not open: every request gets 401. Rotate by
# adding the new token, deploying, then removing the old one.
# The UI's remote functions are a separate surface and do not use these.
API_TOKENS=

# The API reference at /api and the document it reads,
# /api/v1/openapi.json, are served without a token by design.

# Production server only (bun ./build/index.js). Not read by `bun run dev`.
# ORIGIN must match the URL the browser uses, or remote function POSTs are
# rejected as cross-site requests.
# PORT=3000
# ORIGIN=https://command-center.example.com
